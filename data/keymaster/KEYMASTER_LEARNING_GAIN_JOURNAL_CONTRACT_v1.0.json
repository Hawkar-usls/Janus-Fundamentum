          "total_exhaustive_wall_time",
          "learning_speedup"
        ]
      },
      {
        "milestone": "JUXTAPOSE_250x250_N8_CAP105SQ",
        "known": {
          "orders_exhaustive": 40320,
          "champion_peak_raw": 10787,
          "champion_terminal_depth": 4
        },
        "unknown_or_not_yet_accounted": [
          "total_exhaustive_pair_work",
          "total_exhaustive_wall_time",
          "learning_speedup"
        ]
      }
    ]
  },
  "reporting_views": [
    "CURRENT_GAIN_SNAPSHOT",
    "GAIN_BY_MODULE_ABLATION",
    "GAIN_BY_FORMULA_SCALE",
    "GAIN_BY_PIVOT_CONTEXT",
    "RESOURCE_SPENT_VS_SAVED",
    "LEARNING_CURVE",
    "PLATEAU_AND_REGRESSION_WATCH",
    "BEST_AND_WORST_CHECKPOINTS",
    "UNEXPLAINED_GAIN_OR_LOSS_QUEUE_FOR_TOPA"
  ],
  "integration": {
    "reads_from": [
      "EXACT_JANUS_RECEIPTS",
      "M2R_PM",
      "KEYMASTER_RANKER_RECEIPTS",
      "JGPT_TEACHER_CHECKPOINT_METADATA",
      "PIVOT_SLIME_CHECKPOINT_METADATA",
      "TOPA_DETECTIVE_SPIDER_ABLATION_TAGS",
      "CI_RESOURCE_MEASUREMENTS_WHEN_AVAILABLE"
    ],
    "writes_to": [
      "APPEND_ONLY_KLGJ_JSONL",
      "RECOMPUTABLE_SUMMARY_JSON",
      "TOPA_DETECTIVE_SPIDER_UNEXPLAINED_DELTA_QUEUE",
      "META_REGISTRY_CHECKPOINT_SUMMARIES"
    ]
  },
  "laws": [
    "MEASURE_FROM_BASELINE_BEFORE_CLAIMING_BOOST",
    "NO_CROSS_FORMULA_SPEEDUP_WITHOUT_COMPARABILITY_GATE",
    "PHYSICAL_RESOURCE_IS_NOT_CREATED_BY_LEARNING",
    "EFFECTIVE_CAPACITY_MAY_INCREASE_WHEN_WORK_PER_SOLVED_CASE_DECREASES",
    "TRAINING_COST_MUST_BE_COUNTED",
    "NEGATIVE_AND_REGRESSION_EVENTS_ARE_IMMUTABLE",
    "PLATEAU_IS_A_MEASUREMENT_STATE_NOT_A_FAILURE",
    "MODULE_BOOST_REQUIRES_MATCHED_ABLATION",
    "MODEL_PREDICTION_IS_NOT_PROOF",
    "EXACT_REPLAY_IS_THE_PROOF_STATE_AUTHORITY",
    "P_VS_NP_IS_OPEN"
  ]
}