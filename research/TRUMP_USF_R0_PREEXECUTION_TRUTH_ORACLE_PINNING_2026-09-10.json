      "source": "def parse_solver_assignment(lines, nvars):\n    values = {}\n    for raw in lines:\n        line = raw.strip()\n        if not line or line.startswith('c') or line.startswith('s'):\n            continue\n        if line.startswith('v'):\n            tokens = line[1:].strip().split()\n        else:\n            continue\n        for tok in tokens:\n            lit = int(tok)\n            if lit == 0:\n                continue\n            v = abs(lit)\n            if v < 1 or v > nvars:\n                raise ValueError('ASSIGNMENT_LITERAL_OUT_OF_RANGE')\n            val = lit > 0\n            if v in values and values[v] != val:\n                raise ValueError('ASSIGNMENT_CONTRADICTION')\n            values[v] = val\n    if set(values) != set(range(1, nvars + 1)):\n        raise ValueError('ASSIGNMENT_NOT_COMPLETE')\n    return values\n\ndef validate_original_cnf(clauses, assignment):\n    bad = []\n    for i, clause in enumerate(clauses, 1):\n        sat = False\n        for lit in clause:\n            v = abs(lit)\n            val = assignment[v]\n            if (lit > 0 and val) or (lit < 0 and not val):\n                sat = True\n                break\n        if not sat:\n            bad.append(i)\n    return {'pass': not bad, 'bad_clause_indices_1_based': bad}\n",
