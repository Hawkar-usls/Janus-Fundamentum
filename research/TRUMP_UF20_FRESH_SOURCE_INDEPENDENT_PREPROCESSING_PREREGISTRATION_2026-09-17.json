  "generic_source_to_projected_raw_rule": {
    "name": "R000_R111_CANONICAL_PROJECTION",
    "source_independent": true,
    "definition": [
      "Parse every 3-literal DIMACS clause as a Boolean relation over the clause variables in deterministic variable order.",
      "For each assignment in lexicographic Boolean order, mark the assignment satisfying or violating the signed clause according to the already-established R000/R111 relation encoding used by projection_identity.py.",
      "Retain exactly relation records whose canonical relation id is R000 or R111 under that frozen encoding.",
      "Canonicalize variable order and relation-row serialization deterministically.",
      "Do not inspect source name, clause ordinal, downstream route, WL value, solver result, or previous source outcomes when deciding projection membership."
    ],
    "source_specific_allowlist": false,
    "source_specific_clause_ids": false
  },
  "generic_pendant_selection_predicate": {
    "evaluation_domain": "ORIGINAL_PROJECTED_RAW_BEFORE_ANY_REMOVAL",
    "predicate": [
      "The relation has arity exactly 3.",
      "Exactly one variable of the relation has global incidence count exactly 1 in the original projected RAW.",
      "That unique-incidence variable is the pendant leaf; the other two variables, ordered deterministically, form the gateway pair.",
      "Existentially project the relation over the pendant leaf onto the gateway pair.",
      "The attachment is eligible if and only if all four Boolean assignments of the two gateway variables have at least one satisfying leaf witness (boundary support = 4/4)."
    ],
    "tie_or_ambiguity_policy": "FAIL_CLOSED_FOR_THAT_RELATION",
    "forbidden_selection_inputs": [
      "source_name",
      "source_index",
      "clause_id_or_ordinal",
      "preknown_leaf_id",
      "old_UF20_02_to_UF20_05_target_tables",
      "WL_value",
      "portfolio_outcome",
      "route_label",
      "SAT_solver_output",
      "manual_inspection"
    ]
  },
  "one_round_reduction_contract": {
    "round_count": 1,
    "selection_is_computed_only_on_original_projected_raw": true,
    "eligible_attachments_removed_simultaneously": true,
    "iterative_rediscovery_after_removal": false,
    "remove_leaf_variable_if_and_only_if_original_global_incidence_is_one": true,
    "gateway_variables_are_never_removed_by_this_rule": true,
