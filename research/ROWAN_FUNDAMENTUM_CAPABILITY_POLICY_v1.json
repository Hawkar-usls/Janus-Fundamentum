{
  "schema": "janus.fundamentum.rowan_capability_gate.v1",
  "date": "2026-10-28",
  "status": "DRAFT_OFFLINE_ROUTING_ONLY",
  "canonical_rowan_adapter": "Hawkar-usls/Janus:integrations/rowan/janus_rowan_bridge.py",
  "canonical_organism_member": "proof_spine",
  "public_sources": [
    "https://docs.rowansci.com/workflows",
    "https://docs.rowansci.com/api/python/v3/",
    "https://rowansci.com/solutions/agentic-science",
    "https://rowansci.com/pricing"
  ],
  "classes": {
    "GENERAL_COMPUTE": {
      "classification": "NOT_DOCUMENTED_AS_SUPPORTED",
      "destination": "FUNDAMENTUM_GENERAL_COMPUTE_BACKEND",
      "rowan_allowed": false
    },
    "PROOF_VERIFICATION": {
      "classification": "LOCAL_DETERMINISTIC_VERIFICATION",
      "destination": "FUNDAMENTUM_EXACT_CHECKERS",
      "rowan_allowed": false
    },
    "EXACT_ONE_SAT": {
      "classification": "UNSUPPORTED_AS_ROWAN_WORKFLOW",
      "destination": "FUNDAMENTUM_EXACT_SOLVER",
      "rowan_allowed": false
    },
    "MOLECULAR_PKA": {
      "classification": "DOCUMENTED_ROWAN_WORKFLOW_ADAPTER_EXISTS",
      "destination": "JANUS_ROWAN_PKA_BRIDGE",
      "rowan_allowed": true,
      "local_decision_only": true
    },
    "MOLECULAR_OTHER": {
      "classification": "OFFICIAL_WORKFLOWS_EXIST_BUT_NO_FUNDAMENTUM_ADAPTER",
      "destination": "FUTURE_TYPED_ADAPTER",
      "rowan_allowed": false
    },
    "PHYSICAL_CSP_ANALOG": {
      "classification": "SCIENTIFIC_HYPOTHESIS_NO_FAITHFUL_ENCODING_PROVED",
      "destination": "FUNDAMENTUM_FORMAL_FALSIFICATION",
      "rowan_allowed": false
    }
  },
  "limits": {
    "provider_execute": false,
    "provider_auth": false,
    "provider_draft": false,
    "provider_credit_spend": 0,
    "cross_repo_write": false,
    "automatic_provider_dispatch": false,
    "source_code_submission": false,
    "scientific_promotion": false,
    "arbitrary_code_or_shell": false
  },
  "scientific_firewall": [
    "ROWAN_CPU_OR_GPU != ARBITRARY_JOB_RUNNER",
    "MOLECULAR_ENERGY_PREDICTION != EXACT_SAT_ORACLE",
    "FINITE_PHYSICAL_ANALOG != UNIFORM_POLYNOMIAL_ALGORITHM",
    "SIMULATION_OUTPUT != PROOF",
    "API_WORKFLOW_AVAILABLE != USER_ACCOUNT_ENTITLED",
    "ROWAN_JOB_UUID != SCIENTIFIC_VALIDATION",
    "P_VS_NP = OPEN"
  ]
}
