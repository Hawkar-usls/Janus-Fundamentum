  "theorem_candidates": [
    {
      "name": "Decomposability-Defect Criterion",
      "statement": "For an NNF circuit C, let D contain every variable occurring in two children of an AND gate. Every restriction C|alpha for alpha on D is decomposable; SAT(C) is decidable in O(2^|D| |C|) with witness recovery.",
      "status": "PROVED_FOR_THE_EXPLICIT_NNF_MODEL"
    },
    {
      "name": "Deterministic-Clause Embedding Lemma",
      "statement": "Every exact 3-CNF with m clauses has an equivalent O(m)-size NNF expression tree whose OR gates are deterministic and whose maximum gate-type alternation is two.",
      "status": "PROVED_BY_EXPLICIT_CLAUSE_REWRITE"
    }
  ],
  "negative_results": [
    "Every 3-CNF has a linear equivalent deterministic-OR NNF tree with at most two gate-type alternations.",
    "Gate-only tree topology and deterministic OR gates therefore do not imply tractability.",
    "Large decomposability defect is not a hardness certificate: large monotone formulas can have an immediate all-true witness."
  ],
  "next_exact_target": "Dynamic programming over the actual support-overlap/incidence graph with exact boundary messages and strict width accounting.",
  "claim_boundary": "C028 does not prove P=NP, P!=NP, or a lower bound against all algorithms. It proves two structural lemmas in an explicit NNF model, implements exact finite audits, and identifies semantic support overlap as the next target.",
