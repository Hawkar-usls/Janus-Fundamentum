{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.c040.2.producer-lane-c039-adapter.v1",
  "title": "C040.2 producer-lane C039 orchestration certificate",
  "type": "object",
  "required": [
    "schema",
    "canonical_id",
    "terminal",
    "formula_digest",
    "capability_digest",
    "budget_digest",
    "candidate_phase",
    "candidate_manifest_digest",
    "candidates",
    "probes",
    "selected_candidate_id",
    "selected_vtree_digest",
    "work_ledger",
    "discovery_digest",
    "p_vs_np"
  ],
  "properties": {
    "schema": {"const": "janus.c040.2.producer-lane-c039-adapter.v1"},
    "canonical_id": {"const": "C040.2"},
    "terminal": {
      "enum": [
        "VTREE_SELECTED_CERTIFIED",
        "OPEN_PORTFOLIO_EXHAUSTED",
        "OPEN_DISCOVERY_BUDGET",
        "OPEN_FEATURE_LANGUAGE",
        "OPEN_CAPABILITY_STALE",
        "INVALID_DISCOVERY_CERTIFICATE"
      ]
    },
    "formula_digest": {"$ref": "#/$defs/digest"},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "budget_digest": {"$ref": "#/$defs/digest"},
    "candidate_phase": {"const": "FROZEN_BEFORE_PROBES"},
    "candidate_manifest_digest": {"$ref": "#/$defs/digest"},
    "candidates": {"type": "array"},
    "probes": {"type": "array"},
    "selected_candidate_id": {"type": ["string", "null"]},
    "selected_vtree_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "work_ledger": {
      "type": "object",
      "required": [
        "candidate_generation_work_units",
        "probe_work_units",
        "total_work_units"
      ],
      "properties": {
        "candidate_generation_work_units": {"type": "integer", "minimum": 0},
        "probe_work_units": {"type": "integer", "minimum": 0},
        "total_work_units": {"type": "integer", "minimum": 0}
      }
    },
    "discovery_digest": {"$ref": "#/$defs/digest"},
    "p_vs_np": {"const": "OPEN"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
