{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.invalid/schemas/c040-low-affine-dimension-composition-v1.schema.json",
  "title": "JANUS C040 Low Affine Dimension Composition Certificate",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "status", "p_vs_np"],
  "properties": {
    "schema": {
      "const": "janus.c040.low_affine_dimension.v1"
    },
    "status": {
      "enum": ["SAT", "UNSAT", "OPEN_LANGUAGE", "OPEN_DIMENSION_BUDGET"]
    },
    "p_vs_np": {
      "const": "OPEN"
    },
    "language": {
      "enum": ["HORN", "DUAL_HORN"]
    },
    "dual": {
      "type": "boolean"
    },
    "shared": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "q": {
      "type": "integer",
      "minimum": 0
    },
    "L": {
      "type": "integer",
      "minimum": 2
    },
    "budget": {
      "type": "integer",
      "minimum": 1
    },
    "states_needed": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array"
    },
    "witness": {
      "type": "object"
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
