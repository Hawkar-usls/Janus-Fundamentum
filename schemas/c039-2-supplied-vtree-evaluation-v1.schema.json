{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.c039.2.supplied-vtree-evaluation.v1",
  "title": "C039.2 supplied-vtree evaluation certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonical_id",
    "terminal",
    "reason_code",
    "formula_digest",
    "vtree_digest",
    "capability_digest",
    "language_profile_digest",
    "budget_digest",
    "max_message_size",
    "total_representation_size",
    "leaf_work",
    "join_work",
    "projection_work",
    "proof_bytes",
    "closed_nodes",
    "open_nodes",
    "first_open_node_digest",
    "first_open_terminal",
    "first_open_reason_code",
    "root_message_digest",
    "evaluation_certificate_digest"
  ],
  "properties": {
    "schema": {"const": "janus.c039.2.supplied-vtree-evaluation.v1"},
    "canonical_id": {"const": "C039.2"},
    "terminal": {
      "enum": [
        "FACTOR_BUILT",
        "OPEN_LANGUAGE",
        "OPEN_BUDGET",
        "OPEN_REPRESENTATION_GROWTH",
        "INVALID_CERTIFICATE"
      ]
    },
    "reason_code": {
      "enum": [
        "NONE",
        "SINGLE_HEAD_CLOSURE_LOST",
        "PROJECTION_VOLUME",
        "WORK_BUDGET",
        "CERTIFICATE_VOLUME",
        "INVALID_SCOPE",
        "INVALID_VTREE"
      ]
    },
    "formula_digest": {"$ref": "#/$defs/nullableDigest"},
    "vtree_digest": {"$ref": "#/$defs/nullableDigest"},
    "capability_digest": {"$ref": "#/$defs/digest"},
    "language_profile_digest": {"$ref": "#/$defs/digest"},
    "budget_digest": {"$ref": "#/$defs/digest"},
    "max_message_size": {"type": "integer", "minimum": 0},
    "total_representation_size": {"type": "integer", "minimum": 0},
    "leaf_work": {"type": "integer", "minimum": 0},
    "join_work": {"type": "integer", "minimum": 0},
    "projection_work": {"type": "integer", "minimum": 0},
    "proof_bytes": {"type": "integer", "minimum": 0},
    "closed_nodes": {"type": "integer", "minimum": 0},
    "open_nodes": {"type": "integer", "minimum": 0, "maximum": 1},
    "first_open_node_digest": {"$ref": "#/$defs/nullableDigest"},
    "first_open_terminal": {
      "type": ["string", "null"]
    },
    "first_open_reason_code": {
      "type": ["string", "null"]
    },
    "root_message_digest": {"$ref": "#/$defs/nullableDigest"},
    "evaluation_certificate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    }
  }
}
