{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.invalid/schemas/c040-semantic-vtree-discovery-v1.schema.json",
  "title": "C040 portfolio-guided semantic vtree discovery certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formula_digest",
    "canonicalizer_digest",
    "capability_digest",
    "c039_contract_digest",
    "variables",
    "candidate_phase",
    "depends_on_assignment_values",
    "features",
    "candidates",
    "frozen_candidate_count",
    "candidate_manifest_digest",
    "probes",
    "selected_candidate_digest",
    "budgets",
    "work_ledger",
    "terminal",
    "discovery_digest"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "formula_digest",
        "capability_digest",
        "scope",
        "proof_digest",
        "advisory_only",
        "feature_digest"
      ],
      "properties": {
        "schema": {"const": "janus.c040.discovery-feature.v1"},
        "kind": {
          "enum": [
            "CLAUSE_INCIDENCE",
            "EQUALITY_FOREST",
            "FORCED_LITERAL_SET",
            "AFFINE_ROW_SUPPORT",
            "AFFINE_HULL_STATUS",
            "HORN_HEAD_MAP",
            "BETA_ELIMINATION_ORDER",
            "EXACT_OPEN_TRACE"
          ]
        },
        "formula_digest": {"$ref": "#/$defs/sha256"},
        "capability_digest": {"$ref": "#/$defs/sha256"},
        "scope": {"$ref": "#/$defs/stringSet"},
        "proof_digest": {"$ref": "#/$defs/sha256"},
        "advisory_only": {"type": "boolean"},
        "feature_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "vtree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "leaves", "internal_nodes"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "leaves": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "internal_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "left", "right"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "left": {"type": "string", "minLength": 1},
              "right": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate_id",
        "constructor",
        "constructor_digest",
        "feature_digests",
        "generation_proof_digest",
        "generated_before_probe",
        "depends_on_assignment_values",
        "vtree",
        "vtree_digest",
        "candidate_digest"
      ],
      "properties": {
        "schema": {"const": "janus.c040.vtree-candidate.v1"},
        "candidate_id": {"type": "string", "pattern": "^candidate-[0-9]{4}$"},
        "constructor": {
          "enum": [
            "FIXED_CANONICAL_BASELINE_V1",
            "BALANCED_PRIMAL_SEPARATOR_V1",
            "CLAUSE_COOCCURRENCE_V1",
            "EQUALITY_CONTRACTED_V1",
            "AFFINE_SUPPORT_CLUSTER_V1",
            "HORN_HEAD_DISJOINT_V1",
            "BETA_ELIMINATION_V1"
          ]
        },
        "constructor_digest": {"$ref": "#/$defs/sha256"},
        "feature_digests": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "uniqueItems": true
        },
        "generation_proof_digest": {"$ref": "#/$defs/sha256"},
        "generated_before_probe": {"const": true},
        "depends_on_assignment_values": {"const": false},
        "vtree": {"$ref": "#/$defs/vtree"},
        "vtree_digest": {"$ref": "#/$defs/sha256"},
        "candidate_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate_id",
        "formula_digest",
        "capability_digest",
        "c039_contract_digest",
        "vtree_digest",
        "full_compile",
        "terminal",
        "c039_certificate_digest",
        "max_node_representation",
        "total_representation",
        "total_work_units"
      ],
      "properties": {
        "schema": {"const": "janus.c040.c039-probe-receipt.v1"},
        "candidate_id": {"type": "string", "pattern": "^candidate-[0-9]{4}$"},
        "formula_digest": {"$ref": "#/$defs/sha256"},
        "capability_digest": {"$ref": "#/$defs/sha256"},
        "c039_contract_digest": {"$ref": "#/$defs/sha256"},
        "vtree_digest": {"$ref": "#/$defs/sha256"},
        "full_compile": {"const": true},
        "terminal": {
          "enum": [
            "CLOSED_POLY",
            "OPEN_LANGUAGE",
            "OPEN_BUDGET",
            "OPEN_EQUIVALENCE",
            "OPEN_REPRESENTATION_GROWTH",
            "OPEN_COMPOSITION"
          ]
        },
        "c039_certificate_digest": {"$ref": "#/$defs/sha256"},
        "max_node_representation": {"type": "integer", "minimum": 0},
        "total_representation": {"type": "integer", "minimum": 0},
        "total_work_units": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema": {"const": "janus.c040.semantic-vtree-discovery.v1"},
    "formula_digest": {"$ref": "#/$defs/sha256"},
    "canonicalizer_digest": {"$ref": "#/$defs/sha256"},
    "capability_digest": {"$ref": "#/$defs/sha256"},
    "c039_contract_digest": {"$ref": "#/$defs/sha256"},
    "variables": {"$ref": "#/$defs/stringSet"},
    "candidate_phase": {"const": "FROZEN_BEFORE_PROBES"},
    "depends_on_assignment_values": {"const": false},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "frozen_candidate_count": {"type": "integer", "minimum": 0},
    "candidate_manifest_digest": {"$ref": "#/$defs/sha256"},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "selected_candidate_digest": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_candidates",
        "max_feature_work_units",
        "max_candidate_generation_work_units",
        "max_probe_work_units",
        "max_total_work_units",
        "max_certificate_bytes"
      ],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 0},
        "max_feature_work_units": {"type": "integer", "minimum": 0},
        "max_candidate_generation_work_units": {"type": "integer", "minimum": 0},
        "max_probe_work_units": {"type": "integer", "minimum": 0},
        "max_total_work_units": {"type": "integer", "minimum": 0},
        "max_certificate_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "work_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_work_units",
        "candidate_generation_work_units",
        "probe_work_units",
        "total_work_units",
        "certificate_bytes"
      ],
      "properties": {
        "feature_work_units": {"type": "integer", "minimum": 0},
        "candidate_generation_work_units": {"type": "integer", "minimum": 0},
        "probe_work_units": {"type": "integer", "minimum": 0},
        "total_work_units": {"type": "integer", "minimum": 0},
        "certificate_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "terminal": {
      "enum": [
        "VTREE_SELECTED_CERTIFIED",
        "OPEN_PORTFOLIO_EXHAUSTED",
        "OPEN_DISCOVERY_BUDGET",
        "OPEN_FEATURE_LANGUAGE",
        "OPEN_CAPABILITY_STALE",
        "INVALID_DISCOVERY_CERTIFICATE"
      ]
    },
    "discovery_digest": {"$ref": "#/$defs/sha256"}
  },
  "not": {
    "anyOf": [
      {"required": ["assignments"]},
      {"required": ["communication_rows"]},
      {"required": ["truth_table"]},
      {"required": ["evaluation_vector"]},
      {"required": ["branch_values"]}
    ]
  }
}
