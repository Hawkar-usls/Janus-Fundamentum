def build(upk_path: Path, bootstrap_path: Path, order_mode: str) -> dict[str, Any]:
    upk, bootstrap, generators = load_sources(upk_path, bootstrap_path, order_mode)
    right_zero = lift_trajectory(
        [
            {"left": [], "right": [1], "value": 0},
            {"left": [1], "right": [], "value": 0},
        ],
        RIGHT_BOUNDARY,
        3,
    )
    common = subspace_sum(LEFT_BOUNDARY, RIGHT_BOUNDARY, 3)
    if common != COMMON_BOUNDARY:
        raise AssertionError("corrected Node-8 common boundary drift")

    unique_envelopes: dict[bytes, dict[str, Any]] = {}
    quotient_paths = 0
    quotient_cells = 0
    join_correction_counts: dict[int, int] = {0: 0}
    shrink_correction_counts: dict[int, int] = {0: 0, 1: 0}
