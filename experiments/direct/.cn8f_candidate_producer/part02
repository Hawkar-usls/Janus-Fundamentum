        )
        paths = ordinary_hv_paths(len(left_zero), len(right_zero))
        if len(paths) != 4:
            raise AssertionError("4x2 ordinary H/V quotient-path count drift")
        for local_path_index, path in enumerate(paths):
            quotient_paths += 1
            projected_precompact: list[Statistic] = []
            join_corrections: list[int] = []
            shrink_corrections: list[int] = []
            for i, j in path:
                quotient_cells += 1
                left = left_zero[i]
                right = right_zero[j]
                joined_left = subspace_sum(left.left, right.left, 3)
                joined_right = subspace_sum(left.right, right.right, 3)
                left_span = subspace_sum(left.left, left.right, 3)
                right_span = subspace_sum(right.left, right.right, 3)
                current_intersection = subspace_intersection(left_span, right_span, 3)
                join_correction = len(initial_intersection) - len(current_intersection)
                if join_correction != 0:
                    raise AssertionError("corrected Node-8 join correction is not zero")
                join_correction_counts[0] += 1

