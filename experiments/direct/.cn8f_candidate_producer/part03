def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("upk", type=Path)
    parser.add_argument("bootstrap", type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument(
        "--entry-order",
        default="original",
        choices=("original", "reversed", "seeded-shuffle"),
    )
    args = parser.parse_args()
    artifact = build(args.upk, args.bootstrap, args.entry_order)
    args.output.write_bytes(canonical_json(artifact) + b"\n")
    print(
        json.dumps(
            {
                "artifact_bytes": args.output.stat().st_size,
                "artifact_sha256": file_sha256(args.output),
                "semantic_digest": artifact["semantic_digest"],
                "quotient_paths": artifact["quotient_frontier"]["pre_shrink_quotient_path_count"],
                "post_shrink_classes": artifact["quotient_frontier"]["post_shrink_class_count"],
                "local_direct_assignment_tests": artifact["quotient_frontier"]["local_direct_assignment_tests"],
            },
            sort_keys=True,
        )
    )


if __name__ == "__main__":
    main()
