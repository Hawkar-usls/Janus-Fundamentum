def reseal(value: dict[str, Any]) -> dict[str, Any]:
    candidate = copy.deepcopy(value)
    candidate["certificate_bytes"] = 0
    while True:
        unsigned = dict(candidate)
        unsigned.pop("semantic_digest", None)
        candidate["semantic_digest"] = digest(unsigned)
        size = len(canonical_json(candidate) + b"\n")
        if candidate["certificate_bytes"] == size:
            return candidate
        candidate["certificate_bytes"] = size


