        "method": "EXACT_SECOND_UP_K_ON_FIRST_CLOSURE_TRAJECTORIES",
        "second_input_generator_count": 7776,
        "second_output_entry_count": 7776,
        "second_stream_sha256": hashlib.sha256(second_bytes).hexdigest(),
        "second_stream_bytes": len(second_bytes),
        "byte_identical_to_first": True,
        "original_six_reused_in_second_pass": False,
        "source_generator_ids_consumed_in_second_pass": False,
        "repeated_closure_checks": 960000,
    }:
        raise AssertionError("CN7U-INV-08: idempotence receipt")
    if first_checks != 7776 or second_checks != 960000:
        raise AssertionError("CN7U-INV-09: closure work")

    ledger = observed["work_ledger"]
    if ledger.get("gf2_generator_statistics_checked") != 24 or ledger.get("preorder_pairs_replayed") != 36:
        raise AssertionError("CN7U-INV-09: base work ledger")
    if ledger.get("nonvacuous_control_direct_witnesses_replayed") != 2 or ledger.get("first_up_k_checks") != 7776:
        raise AssertionError("CN7U-INV-09: direct/first work ledger")
