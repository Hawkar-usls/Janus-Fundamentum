@dataclass(frozen=True, order=True)
class Point:
    left: tuple[int, ...]
    right: tuple[int, ...]
    value: int


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")


def sha(value: Any) -> str:
    return hashlib.sha256(canonical_json(value)).hexdigest()


def file_sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def basis(rows: Iterable[int], dimension: int) -> tuple[int, ...]:
    pivots: dict[int, int] = {}
    for raw in rows:
        row = int(raw)
        if row < 0 or row >= (1 << dimension):
            raise AssertionError("GF(2) vector range")
        while row:
            pivot = row.bit_length() - 1
            if pivot in pivots:
                row ^= pivots[pivot]
            else:
                pivots[pivot] = row
                for other, value in list(pivots.items()):
                    if other != pivot and ((value >> pivot) & 1):
                        pivots[other] = value ^ row
                break
    for low in sorted(pivots):
        for high in sorted(pivots, reverse=True):
            if high != low and ((pivots[high] >> low) & 1):
                pivots[high] ^= pivots[low]
    return tuple(pivots[index] for index in sorted(pivots, reverse=True))


def vectors(space: Sequence[int]) -> set[int]:
    result = {0}
    for row in space:
        result |= {value ^ int(row) for value in tuple(result)}
    return result


def add_spaces(a: Sequence[int], b: Sequence[int]) -> tuple[int, ...]:
    return basis((*a, *b), 3)


def meet_spaces(a: Sequence[int], b: Sequence[int]) -> tuple[int, ...]:
    return basis(vectors(a) & vectors(b), 3)


def decode_coordinate_space(space: Sequence[int], coordinate_basis: Sequence[int]) -> tuple[int, ...]:
    rows: list[int] = []
    for mask in space:
        row = 0
        for index, ambient_row in enumerate(coordinate_basis):
            if (int(mask) >> index) & 1:
                row ^= int(ambient_row)
        rows.append(row)
    return basis(rows, 3)


def lift(raw: Sequence[dict[str, Any]], coordinate_basis: Sequence[int]) -> tuple[Point, ...]:
    return tuple(
        Point(
            decode_coordinate_space(item["left"], coordinate_basis),
            decode_coordinate_space(item["right"], coordinate_basis),
            int(item["value"]),
        )
        for item in raw
    )


def encode(path: Sequence[Point]) -> list[dict[str, Any]]:
    return [
        {"left": list(point.left), "right": list(point.right), "value": int(point.value)}
        for point in path
    ]


def reduce_typical(path: Sequence[Point]) -> tuple[Point, ...]:
    current = list(path)
    while True:
        changed = False
        for index in range(1, len(current)):
            if current[index - 1] == current[index]:
                del current[index]
                changed = True
                break
        if changed:
            continue
        for start in range(len(current)):
            for end in range(start + 2, len(current)):
                if (current[start].left, current[start].right) != (
                    current[end].left,
                    current[end].right,
                ):
                    continue
                values = [point.value for point in current[start : end + 1]]
                monotone = (
                    values[0] <= values[-1]
                    and all(values[0] <= value <= values[-1] for value in values[1:-1])
                ) or (
                    values[0] >= values[-1]
                    and all(values[0] >= value >= values[-1] for value in values[1:-1])
                )
                if monotone:
                    del current[start + 1 : end]
                    changed = True
