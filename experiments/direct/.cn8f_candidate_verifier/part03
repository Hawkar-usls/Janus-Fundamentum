def repaired_tamper_tests(candidate: dict[str, Any], replayed: dict[str, Any]) -> int:
    mutations = []

    def add(mutator):
        item = copy.deepcopy(candidate)
        mutator(item)
        mutations.append(seal(item))

    add(lambda item: item["source"].__setitem__("base_exact_head", "0" * 40))
    add(lambda item: item["exact_frontier"].__setitem__("diagonal_join_steps", 1))
    add(lambda item: item["geometry"]["shrink_correction_counts_over_quotient_cells"].__setitem__("1", 39))
    add(lambda item: item["quotient_frontier"].__setitem__("pre_shrink_quotient_path_count", 25))
    add(lambda item: item["quotient_frontier"]["classes"].pop())
    add(lambda item: item["quotient_frontier"]["path_to_class"][0].__setitem__("class_id", "CN8-S99"))
    add(lambda item: item["quotient_frontier"].__setitem__("local_direct_assignment_tests", 17423))
    add(lambda item: item["admission_boundary"].__setitem__("corrected_node8_parent_frontier_compression_admitted", True))
    add(lambda item: item.__setitem__("next_gate_status", "OPEN"))
    add(lambda item: item["admission_boundary"].__setitem__("p_vs_np", "RESOLVED"))

    rejected = 0
    for tampered in mutations:
        try:
            verify(tampered, replayed)
        except AssertionError:
            rejected += 1
    if rejected != len(mutations):
        raise AssertionError("digest-repaired tamper escaped")
    return rejected


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("upk", type=Path)
    parser.add_argument("bootstrap", type=Path)
    parser.add_argument("candidate", type=Path)
    parser.add_argument("--tamper-self-test", action="store_true")
    args = parser.parse_args()

    replayed = replay(args.upk, args.bootstrap)
    candidate = json.loads(args.candidate.read_text(encoding="utf-8"))
    verify(candidate, replayed)
    rejected = repaired_tamper_tests(candidate, replayed) if args.tamper_self_test else 0
    print("JANUS_C049_1_B4_6_3_CORRECTED_NODE8_FRONTIER_VERIFIER = PASS")
    print("INVARIANTS = 12/12")
    print("QUOTIENT_PATHS =", replayed["path_count"])
    print("POST_SHRINK_CLASSES =", len(replayed["classes"]))
    print("LOCAL_DIRECT_ASSIGNMENTS =", replayed["direct_tests"])
    if args.tamper_self_test:
        print(f"DIGEST_REPAIRED_TAMPERS_REJECTED = {rejected}/10")


if __name__ == "__main__":
    main()
