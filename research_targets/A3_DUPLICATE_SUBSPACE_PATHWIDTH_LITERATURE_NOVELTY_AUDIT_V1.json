  "audit_question": "Can the admitted duplicate-subspace path-width theorem be claimed as a new result in the mathematical literature?",
  "theorem_statement": "For m >= 2 indexed occurrences of the same subspace U of dimension d, every linear layout has width profile [0,d,...,d,0], hence path-width d; for m=1 the maximum cut width is 0.",
  "primary_sources": [
    {
      "id": "JKO_2017",
      "authors": ["Jisu Jeong", "Eun Jung Kim", "Sang-il Oum"],
      "title": "The art of trellis decoding is fixed-parameter tractable",
      "arxiv": "1507.02184v4",
      "journal": "IEEE Transactions on Information Theory 63(11), 7178-7205 (2017)",
      "doi": "10.1109/TIT.2017.2740283",
      "source_role": "CONTROLLING_SUBSPACE_ARRANGEMENT_DEFINITION",
      "relevant_fact": "For indexed input subspaces V_1,...,V_n, layout width at cut i is dim((V_1+...+V_i) intersect (V_{i+1}+...+V_n)); path-width is the minimum feasible maximum over permutations.",
      "audit_effect": "Substituting every V_j=U makes each nonempty side sum equal U. For every internal cut when m>=2, the intersection is U and has dimension d. Therefore the admitted theorem is an immediate specialization of the published definition."
    },
    {
      "id": "KASHYAP_2007_2008",
      "authors": ["Navin Kashyap"],
      "title": "Matroid Pathwidth and Code Trellis Complexity",
      "arxiv": "0705.1384",
      "source_role": "MATROID_TRELLIS_EQUIVALENCE_PRIOR_ART",
      "relevant_fact": "Matroid path-width is related to minimum trellis state-complexity and is defined through linear layouts of represented matroids.",
      "audit_effect": "The one-dimensional specialization of duplicate identical subspaces lies in pre-existing matroid/trellis-width theory rather than defining a new width parameter."
    },
    {
      "id": "HLINENY_2016",
      "authors": ["Petr Hlineny"],
      "title": "A Simpler Self-reduction Algorithm for Matroid Path-width",
      "arxiv": "1605.09520",
      "source_role": "PARALLEL_ELEMENT_GEOMETRIC_SPECIALIZATION",
      "relevant_fact": "Vector representations can be seen as point configurations; parallel vectors are represented by identical points, and the connectivity value of a separation is the rank of the intersection of the spans of its two sides.",
      "audit_effect": "For d=1, m>=2 identical one-dimensional occurrences are the standard parallel-element situation, whose internal separation connectivity is immediately 1."
    }
  ],
