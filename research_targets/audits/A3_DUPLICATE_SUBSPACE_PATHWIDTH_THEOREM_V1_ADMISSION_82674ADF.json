  "theorem": {
    "field": "GF(2)",
    "premise": "An indexed arrangement consists of m >= 2 distinct occurrence identities, each with the same geometric subspace U <= GF(2)^n of dimension d.",
    "cut_width_definition": "dim(span(left occurrences) intersect span(right occurrences))",
    "conclusion": "Every linear layout has maximum cut width exactly d, hence the arrangement path-width is exactly d.",
    "excluded_case": "For m = 1, maximum cut width is 0; the theorem intentionally does not assert d."
  },
  "proof_argument": [
    "At every internal cut 1 <= i < m, both sides contain at least one indexed occurrence.",
    "Every geometric occurrence equals U, so every nonempty side spans exactly U.",
    "Thus the internal boundary is U intersect U = U and its dimension is d.",
    "At cuts 0 and m, one side has zero span, so boundary width is 0.",
    "Therefore every layout has width profile [0,d,...,d,0] and maximum d.",
    "Since every layout maximum equals d, their minimum (path-width) equals d."
  ],
