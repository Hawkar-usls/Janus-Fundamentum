  "purpose": "Make Physarius the mandatory provenance-carrying vascular tissue for every cross-repository edge in the JANUS Activation Circuit while keeping transport strictly separate from authority and execution.",
  "laws": [
    "NO_CROSS_REPO_STATE_WITHOUT_VESSEL_RECEIPT",
    "VESSEL_NE_PERMISSION",
    "DELIVERY_NE_EXECUTION",
    "PHYSARIUS_TRANSPORT_HAS_NO_IMPLICIT_COMMAND_AUTHORITY",
    "PHYSARIUS_TRANSPORT_HAS_NO_IMPLICIT_EXTERNAL_EFFECT_AUTHORITY",
    "SOURCE_AND_DESTINATION_MUST_BE_EXPLICITLY_BOUND",
    "PAYLOAD_MUST_BE_CONTENT_HASH_BOUND",
    "AUTHORITY_CEILING_MUST_TRAVEL_WITH_THE_PACKET",
    "RECEIPT_MUST_BIND_SOURCE_DESTINATION_PAYLOAD_AND_PARENT_LINEAGE",
    "REPLAY_MUST_NOT_CREATE_A_SECOND_EXECUTION",
    "TWO_TRANSPORTS_NE_TWO_EXECUTIONS",
    "MISSING_OR_AMBIGUOUS_BINDING_FAILS_CLOSED"
