  "separation_of_concerns": {
    "physarius": [
      "DISCOVER",
      "INDEX",
      "SELECT",
      "PULL",
      "TRANSFER_PACKET",
      "RETURN_RECEIPT"
    ],
    "activator": [
      "AUTHORIZE_COGNITIVE_GENERATION",
      "AUTHORIZE_DISPATCH_WHEN_SEPARATELY_GRANTED",
      "ISSUE_BOUNDED_EXECUTION_GRANT",
      "RECONCILE_EXECUTION_RESULT",
      "RETURN_HOME"
    ],
    "forbidden_inference": "A successful Physarius delivery MUST NOT be interpreted as permission, execution, scientific truth, proof authority, or external-effect authority."
  },
