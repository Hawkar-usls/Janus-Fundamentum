{
  "schema": "janus.physarius.hemispheric_commissure_contract.v1",
  "contract_id": "PHYSARIUS_HEMISPHERIC_COMMISSURE_V1",
  "created_at": "2026-08-31",
  "purpose": "Provide a duplex, provenance-preserving, zero-authority conduit between LEFT_HRAIN structural context and RIGHT_INAIHR associative context without merging the hemispheres or bypassing DemiHead disagreement preservation.",
  "endpoints": {
    "LEFT_HRAIN": {
      "repository": "Hawkar-usls/Hrain",
      "role": "STRUCTURAL_CONTEXT",
      "packet_schema": "janus.demihead.hemisphere_packet.v3",
      "unattested_packet_schema": "janus.demihead.hemisphere_packet.v1"
    },
    "RIGHT_INAIHR": {
      "repository": "Hawkar-usls/iNaiHR",
      "role": "ASSOCIATIVE_CONTEXT",
      "packet_schema": "janus.demihead.hemisphere_packet.v3",
      "unattested_packet_schema": "janus.demihead.hemisphere_packet.v1"
    }
  },
  "duplex_lanes": [
    "LEFT_TO_RIGHT",
    "RIGHT_TO_LEFT"
  ],
  "message_classes": [
    "ATTENTION_POINTER",
    "CONTEXT_REQUEST",
    "CONTEXT_RETURN",
    "HYPOTHESIS_CANDIDATE",
    "CONTRADICTION_OR_DISAGREEMENT",
    "AMBIGUITY_SET",
    "PROVENANCE_POINTER",
    "DEBT_POINTER"
  ],
  "exchange_envelope": {
    "schema": "janus.physarius.hemispheric_exchange.v1",
    "required": [
      "exchange_id",
      "source_hemisphere",
      "target_hemisphere",
      "source_packet_sha256",
      "message_class",
      "payload",
      "previous_exchange_sha256",
      "control"
    ],
    "payload_rule": "Payload may contain semantic/structural pointers and candidate statements, but must not claim authority greater than its source packet.",
    "chain_rule": "Every non-genesis exchange binds the previous accepted exchange SHA-256; forks remain explicit and are not silently linearized."
  },
  "demihead_role": {
    "mode": "BIND_COMPARE_PRESERVE_DISAGREEMENT",
    "rule": "The commissure transports context. DemiHead remains the comparison/reconciliation layer and must preserve disagreement unless a separate receipt resolves it.",
    "direct_merge": false
  },
  "authority": {
    "transfer": "READ_ONLY_CONTEXT_TRANSFER",
    "authority_delta": 0,
    "mass_effect_budget_delta": 0,
    "source_mutation": false,
    "cross_hemisphere_mutation": false,
    "scientific_claim_promotion": false,
    "proof_authority": false
  },
  "laws": [
    "HEMISPHERE_DIFFERENCE_IS_PRESERVED_NOT_ERASED",
    "STRUCTURAL_CONTEXT_NE_ASSOCIATIVE_CONTEXT",
    "BOTH_HEMISPHERES_AGREE_NE_TRUTH",
    "CROSS_HEMISPHERE_RECURRENCE_NE_INDEPENDENT_REPLICATION",
    "COMMISSURE_TRANSPORT_NE_EVIDENCE",
    "DISAGREEMENT_IS_A_FIRST_CLASS_STATE",
    "NO_DIRECT_CROSS_HEMISPHERE_MUTATION",
    "EVERY_EXCHANGE_MUST_PRESERVE_SOURCE_PACKET_PROVENANCE",
    "FORKED_EXCHANGE_HISTORY_MUST_NOT_BE_LAUNDERED_INTO_A_SINGLE_LINEAR_HISTORY"
  ],
  "physarius": {
    "left_external_intake": "PHYSARIUS_NETWORK_HRAIN_LIVE_v1",
    "left_internal_intake": "PHYSARIUS_INTERNAL_REPO_HRAIN_LIVE_v1",
    "right_external_intake": "PHYSARIUS_NETWORK_HRAIN_LIVE_v1",
    "right_internal_intake": "PHYSARIUS_INTERNAL_REPO_HRAIN_LIVE_v1",
    "right_internal_trunk_repo_id": "inaihr_trunk"
  },
  "terminal": {
    "healthy": "COMMISSURE_DUPLEX_PASS",
    "degraded": "COMMISSURE_ONE_LANE_DEGRADED",
    "blocked": "COMMISSURE_FAIL_CLOSED",
    "promotion": "NO_AUTOMATIC_PROMOTION"
  }
}
