{
  "registry_version": "1.0.0",
  "allowed_hypothesis_statuses": [
    "PROPOSED",
    "UNDER_ATTACK",
    "OPEN",
    "FORMALIZING",
    "INDEPENDENT_REPRODUCTION",
    "PEER_REVIEW",
    "PROVED"
  ],
  "allowed_terminal_statuses": [
    "DESTROYED",
    "REJECTED"
  ],
  "allowed_attack_results": [
    "SURVIVED",
    "WEAKENED",
    "DESTROYED",
    "INCONCLUSIVE"
  ],
  "allowed_reproducibility_levels": [
    "R0",
    "R1",
    "R2",
    "R3",
    "R4",
    "R5"
  ],
  "required_hypothesis_fields": [
    "id",
    "title",
    "status",
    "reproducibility",
    "statement",
    "consequence_if_true",
    "falsification_conditions",
    "attack_surface",
    "registered_attacks",
    "claim_boundary",
    "created_utc",
    "updated_utc"
  ],
  "required_attack_fields": [
    "id",
    "hypothesis_id",
    "type",
    "targeted_failure_mode",
    "method",
    "result",
    "decisive",
    "artifact",
    "created_utc"
  ],
  "id_patterns": {
    "hypothesis": "^H[0-9]{3,}$",
    "attack": "^A[0-9]{3,}$",
    "observation": "^O[0-9]{3,}$",
    "cycle": "^C[0-9]{3,}$",
    "discovery": "^D[0-9]{3,}$"
  },
  "invariants": [
    "Every ID is unique inside its registry.",
    "Every attack references an existing live or graveyard hypothesis.",
    "Every registered attack ID exists in attacks.json.",
    "OPEN never means proved or probably true.",
    "PROVED requires reproducibility R5 and an independently checkable proof artifact.",
    "Destroyed and rejected hypotheses remain permanently addressable."
  ]
}
